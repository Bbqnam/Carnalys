generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model VehicleRecord {
  id                 String          @id
  vin                String?         @unique
  registrationNumber String?         @unique
  make               String
  model              String
  variant            String?
  modelYear          Int
  registrationYear   Int?
  bodyStyle          String
  fuelType           String
  transmission       String
  drivetrain         String?
  horsepower         Int?
  engineDescription  String?
  engineDisplacement Int?
  fuelConsumption    String?
  firstRegistration  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  listings           ListingRecord[]

  @@index([make, model])
  @@index([modelYear])
}

model ListingRecord {
  id                         String                   @id
  provider                   String
  sourceScope                String                   @default("default")
  externalId                 String
  vehicleId                  String
  listingUrl                 String
  sellerName                 String?
  sellerType                 String
  priceAmount                Int
  previousPriceAmount        Int?
  monthlyCostAmount          Int?
  currency                   String                   @default("SEK")
  mileageKm                  Int
  location                   String
  municipality               String
  latitude                   Float?
  longitude                  Float?
  description                String?
  serviceHistory             String                   @default("unknown")
  ownerCount                 Int?
  status                     String                   @default("active")
  publishedAt                DateTime?
  sourceUpdatedAt            DateTime?
  firstSeenAt                DateTime
  lastSeenAt                 DateTime
  synchronizedAt             DateTime
  removedAt                  DateTime?
  rawPayload                 Json?
  contentHash                String?
  imageHash                  String?
  equipmentHash              String?
  missingReconciliationCount Int                      @default(0)
  vehicle                    VehicleRecord            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  images                     ListingImageRecord[]
  equipment                  ListingEquipmentRecord[]
  analysis                   ListingAnalysisRecord?

  @@unique([provider, externalId])
  @@index([provider, sourceScope, status])
  @@index([vehicleId])
  @@index([vehicleId, status])
  @@index([status, priceAmount])
  @@index([status, publishedAt, synchronizedAt, id])
  @@index([provider, sourceScope, status, lastSeenAt])
  @@index([mileageKm])
  @@index([lastSeenAt])
}

/// Append-only log of everything we have ever observed about a listing's
/// market state. This is the only place historical market data lives —
/// `ListingRecord` holds just the current state, which is overwritten on
/// every sync.
///
/// A row is written only when an observed value actually *changes* (or on
/// first/last sighting), never once per crawler run: a listing seen
/// unchanged 300 times produces one row, not 300. See
/// `recordListingObservations` for the change detection.
///
/// Deliberately has no foreign key to `ListingRecord`. History must survive
/// the listing row it describes — including a future cascade from
/// `VehicleRecord` — because a disappearance is not a deletion of what we
/// learned. Nothing in the application ever deletes from this table.
model ListingObservation {
  id                  BigInt   @id @default(autoincrement())
  listingId           String
  provider            String
  /// When this state was first observed by us — not when the seller changed
  /// it, which the marketplace does not tell us.
  observedAt          DateTime
  /// first_seen | price_change | mileage_change | status_change | disappeared | relisted
  kind                String
  priceAmount         Int
  previousPriceAmount Int?
  mileageKm           Int
  sellerType          String
  /// Listing status *as we observed it*: active | reserved | sold | removed.
  /// "removed" means the ad left the marketplace, which is not evidence of a
  /// sale — see the `disappeared` kind.
  status              String
  createdAt           DateTime @default(now())

  @@unique([listingId, observedAt, kind])
  @@index([listingId, observedAt])
  @@index([observedAt])
  @@index([kind, observedAt])
}

model ListingAnalysisRecord {
  listingId            String        @id
  marketValueAmount    Int
  marketValueMinimum   Int
  marketValueMaximum   Int
  comparableCount      Int
  comparablePrices     Int[]         @default([])
  confidence           String
  dealScore            Int
  dealScoreFactors     Json          @default("[]")
  buyConfidenceScore   Int
  buyConfidenceFactors Json          @default("[]")
  annualOwnershipCost  Int
  ownershipCostItems   Json          @default("[]")
  methodologyVersion   String
  calculatedAt         DateTime
  sourceSynchronizedAt DateTime
  listing              ListingRecord @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([calculatedAt])
  @@index([dealScore])
  @@index([buyConfidenceScore])
}

model ListingImageRecord {
  id           Int           @id @default(autoincrement())
  listingId    String
  url          String
  thumbnailUrl String?
  alt          String?
  position     Int
  width        Int?
  height       Int?
  listing      ListingRecord @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, url])
  @@index([listingId, position])
}

model ListingEquipmentRecord {
  id        Int           @id @default(autoincrement())
  listingId String
  label     String
  listing   ListingRecord @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, label])
}

model ImportRun {
  id                  String               @id
  provider            String
  sourceScope         String
  mode                String               @default("incremental")
  phase               String               @default("starting")
  status              String
  startedAt           DateTime
  completedAt         DateTime?
  heartbeatAt         DateTime?
  resumedCount        Int                  @default(0)
  pagesProcessed      Int                  @default(0)
  partitionsProcessed Int                  @default(0)
  fetchedCount        Int                  @default(0)
  importedCount       Int                  @default(0)
  createdCount        Int                  @default(0)
  updatedCount        Int                  @default(0)
  unchangedCount      Int                  @default(0)
  failedCount         Int                  @default(0)
  removedCount        Int                  @default(0)
  cleanupEligible     Boolean              @default(false)
  cleanupAppliedAt    DateTime?
  stopReason          String?
  errorMessage        String?
  checkpoints         ImportCheckpoint[]
  errors              ImportRunError[]
  lock                SynchronizationLock?

  @@index([provider, startedAt])
  @@index([provider, sourceScope, mode, status, startedAt])
  @@index([status, heartbeatAt])
}

model ImportCheckpoint {
  id                      String    @id
  runId                   String
  sequence                String
  status                  String    @default("pending")
  yearFrom                Int
  yearTo                  Int
  priceFrom               Int
  priceTo                 Int
  unboundedPriceTo        Boolean   @default(false)
  mileageFrom             Int
  mileageTo               Int
  nextPage                Int       @default(1)
  lastPage                Int?
  totalMatches            Int?
  processedCount          Int       @default(0)
  createdCount            Int       @default(0)
  updatedCount            Int       @default(0)
  unchangedCount          Int       @default(0)
  rejectedCount           Int       @default(0)
  errorCount              Int       @default(0)
  lastProcessedExternalId String?
  startedAt               DateTime?
  completedAt             DateTime?
  heartbeatAt             DateTime?
  lastError               String?
  run                     ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, status, sequence])
}

model ImportRunError {
  id                String    @id
  runId             String
  checkpointId      String?
  phase             String
  page              Int?
  attempt           Int?
  httpStatus        Int?
  message           String
  requestParameters Json?
  createdAt         DateTime  @default(now())
  run               ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model SynchronizationLock {
  provider    String    @id
  runId       String    @unique
  mode        String
  acquiredAt  DateTime
  heartbeatAt DateTime
  run         ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model CatalogMakeFacet {
  make      String   @id
  count     Int
  updatedAt DateTime
}

model CatalogModelFacet {
  make      String
  model     String
  count     Int
  updatedAt DateTime

  @@id([make, model])
  @@index([model])
}

model CatalogYearFacet {
  modelYear Int      @id
  count     Int
  updatedAt DateTime
}

model CatalogSummary {
  id                 String    @id
  activeListingCount Int
  minimumPrice       Int
  maximumPrice       Int
  lastSynchronizedAt DateTime?
  facetsUpdatedAt    DateTime
}
