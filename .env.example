# Local development database. Replace with the production database connection
# when the persistence adapter moves to PostgreSQL.
# Prefer an absolute file URL when overriding this value. The application and
# Prisma CLI otherwise default to <project>/prisma/dev.db automatically.
# DATABASE_URL="file:/absolute/path/to/Car_Finder/prisma/dev.db"

# Unofficial development source. Keep the adapter replaceable and do not call
# it from request-serving code.
BLOCKET_UNOFFICIAL_API_URL="https://blocket-api.se"
BLOCKET_IMPORT_QUERY=""
