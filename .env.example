# PostgreSQL connection strings. DATABASE_URL is used by the running app
# (pooled connection); DIRECT_URL is used by Prisma CLI tooling for
# migrations (unpooled, required by the schema engine).
DATABASE_URL="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Unofficial development source. Keep the adapter replaceable and do not call
# it from request-serving code.
BLOCKET_UNOFFICIAL_API_URL="https://blocket-api.se"
BLOCKET_IMPORT_QUERY=""

# Frequent newest-first refresh. The importer stops earlier when it reaches this
# age boundary on consecutive pages containing only already-known listings.
# Pages also fetch per-listing detail data (body style, engine, equipment)
# for any listing not already enriched, one extra request per such
# listing — but known, already-enriched listings reuse cached data instead
# of hitting the network, so steady-state pages stay fast. A page with an
# unusually large batch of brand-new listings will still take longer.
BLOCKET_INCREMENTAL_LOOKBACK_HOURS="72"
BLOCKET_INCREMENTAL_KNOWN_PAGES="2"
BLOCKET_INCREMENTAL_MAX_PAGES="10"

# Optional local watch process and bounded post-sync analysis work.
DATA_SYNC_WATCH_INTERVAL_MINUTES="15"
SYNC_ANALYSIS_REFRESH_LIMIT="250"
ANALYSIS_BATCH_SIZE="250"

# Shared secret for the production sync cron (src/app/api/sync/route.ts).
# Set this in the Vercel project settings; Vercel automatically sends it as
# "Authorization: Bearer <value>" on its own cron invocations. Note: Vercel's
# Hobby plan only runs cron jobs once per day regardless of the schedule in
# vercel.json — true 30-minute refresh requires a Pro plan.
CRON_SECRET=""
