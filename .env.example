# PostgreSQL connection strings. DATABASE_URL is used by the running app
# (pooled connection); DIRECT_URL is used by Prisma CLI tooling for
# migrations (unpooled, required by the schema engine).
DATABASE_URL="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=verify-full"

# Postgres client pool size per process. Defaults to 15 (sized for the full
# reconciliation's concurrent writes). A serverless request deployment, where
# every instance opens its own pool behind the connection pooler, can set this
# lower (e.g. 5).
PRISMA_POOL_MAX="15"

# Unofficial development source. Keep the adapter replaceable and do not call
# it from request-serving code.
BLOCKET_UNOFFICIAL_API_URL="https://blocket-api.se"
BLOCKET_IMPORT_QUERY=""

# Frequent newest-first refresh. The importer stops earlier when it reaches this
# age boundary on consecutive pages containing only already-known listings.
# Pages also fetch per-listing detail data (body style, engine, equipment)
# for any listing not already enriched, one extra request per such
# listing — but known, already-enriched listings reuse cached data instead
# of hitting the network, so steady-state pages stay fast. A page with an
# unusually large batch of brand-new listings will still take longer.
BLOCKET_INCREMENTAL_LOOKBACK_HOURS="72"
BLOCKET_INCREMENTAL_KNOWN_PAGES="2"
BLOCKET_INCREMENTAL_MAX_PAGES="10"

# Wayke is opt-in only: no route, cron, or watcher invokes it automatically.
# A controlled first run is `npm run data:sync:wayke:sample` (one page).
WAYKE_INCREMENTAL_MAX_PAGES="20"
WAYKE_INCREMENTAL_KNOWN_PAGES="2"

# full (default) keeps structured source JSON for detail-cache reuse; metadata
# keeps only import time; none disables raw source retention. HTML and image
# files are never stored in PostgreSQL in any mode.
RAW_LISTING_PAYLOAD_RETENTION="full"

# Optional local watch process and bounded post-sync analysis work.
DATA_SYNC_WATCH_INTERVAL_MINUTES="15"
SYNC_ANALYSIS_REFRESH_LIMIT="250"
ANALYSIS_BATCH_SIZE="250"

# Shared secret for the production sync cron (src/app/api/sync/route.ts).
# Set this in the Vercel project settings; Vercel automatically sends it as
# "Authorization: Bearer <value>" on its own cron invocations. vercel.json uses
# a once-daily schedule supported by Hobby; more frequent refreshes require Pro.
CRON_SECRET=""

# Daily administrator market report. RESEND_API_KEY stays server-side.
# DAILY_REPORT_FROM must use a sender/domain verified in Resend.
RESEND_API_KEY=""
DAILY_REPORT_FROM="Carnalys <reports@example.com>"
DAILY_REPORT_TO=""
NEXT_PUBLIC_APP_URL="https://carnalys.vercel.app"

# Used only while running npm run admin:create. Remove the password afterwards.
CARNALYS_ADMIN_USERNAME=""
CARNALYS_ADMIN_PASSWORD=""

# Bounded direct Blocket availability checks. Maximum accepted value is 500.
BLOCKET_VERIFICATION_SAMPLE_SIZE="300"

# Carnalys Analyst. The OpenAI key is server-only and must never use a
# NEXT_PUBLIC_ prefix. Luna is the GPT-5.6 cost-optimized default.
OPENAI_API_KEY=""
CARNALYS_ANALYST_MODEL="gpt-5.6-luna"
CARNALYS_ANALYST_REASONING_EFFORT="low"

# Per-user request and execution bounds. The route also hard-caps model turns
# at 3, read-only tool calls at 4, search candidates at 20, details at 5, and
# comparisons at 3.
CARNALYS_ANALYST_REQUESTS_PER_10_MINUTES="10"
CARNALYS_ANALYST_TIMEOUT_MS="45000"
